# Copy to `.env` and fill in locally. Never commit `.env`.

# W4H API base URL (no trailing path beyond /api if using nginx proxy use full api origin)
W4H_API_BASE=http://localhost:2026

# Personal API key from Profile → API keys (w4h_sk_…)
W4H_API_KEY=

# Folder holding the CSV files to import (manifest.yaml is built/stored here).
# Production: your own Fitbit export folder. Dev/testing: point at a sibling checkout
# (do not copy CSVs into this repo):
#
#   W4H/
#     w4h-sample-icde-demo-csv/          ← data package
#     w4h-fitbit-csv-file-importer/      ← this repo
#
# W4H_DATA_DIR=../w4h-sample-icde-demo-csv/data
W4H_DATA_DIR=

# Import target — use a throwaway dataset when testing with ICDE sample files
# (this importer sends table_prefix: fitbit, not icde_demo).
W4H_DATASET_ID=
